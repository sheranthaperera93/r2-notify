{
  "name": "r2-notify-client",
  "version": "1.2.1",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch --clean",
    "build": "rimraf dist && tsup src/index.ts --dts --format cjs,esm --sourcemap",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test && npm run lint"
  },
  "keywords": [
    "notifications",
    "websocket",
    "client",
    "real-time",
    "r2-notify"
  ],
  "author": "Sherantha Perera",
  "license": "MIT",
  "description": "Framework-agnostic WebSocket notification client for r2-notify-server. Consumes real-time events and emits notification actions.",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/eventemitter3": "^1.2.0",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eventemitter3": "^5.0.1",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
