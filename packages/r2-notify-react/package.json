
{
  "name": "r2-notify-react",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "r2-notify-client": "*"
  },
  "scripts": {
    "dev": "tsup --watch --clean",
    "build": "rimraf dist && tsup src/index.ts --dts --format cjs,esm --sourcemap",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "description": "React bindings (Provider + hooks) for r2-notify-client.",
  "keywords": ["react", "notifications", "websocket", "r2-notify"],
  "author": "Sherantha Perera",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.12",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
